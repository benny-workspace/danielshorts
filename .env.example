# ---------------------------------------------------------------------------
# K-Drama Dreams — environment
#
# Copy to .env for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (never commit real values).
#
# The app RUNS WITH NONE OF THESE SET. Each block below switches on one
# capability; anything unconfigured degrades gracefully instead of erroring.
# Check what is live at any time: GET /api/config/health
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Public origin, used for Stripe redirects, download links and magic links.
# Leave BLANK on Vercel: links are then built from the domain each request
# actually arrived on, which is what your customers see. Set it only if you
# serve the client from a different host than the API — doing so also enables
# CORS for exactly that origin.
APP_URL=

# Signs download links and sign-in sessions. REQUIRED IN PRODUCTION.
# Generate one with:  openssl rand -base64 32
APP_SECRET=

# ---------------------------------------------------------------------------
# Payments — pick ONE of the two paths below
# ---------------------------------------------------------------------------

# Path A (recommended): API keys. Enables Stripe Checkout Sessions, which carry
# quiz answers as metadata so fulfilment is fully automatic.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Path B (no-code): paste the Payment Link URL for each tier. Used only when
# STRIPE_SECRET_KEY is absent. Dashboard → Product catalogue → Payment links
STRIPE_PAYMENT_LINK_BLUEPRINT=
STRIPE_PAYMENT_LINK_BUNDLE=
STRIPE_PAYMENT_LINK_COACHING=

# Required for automatic delivery on BOTH paths. Without it, payments succeed
# but nothing is generated or emailed.
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# AI personalisation (optional)
# Without it, blueprints use the built-in written fallback.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Transactional email (optional)
# Without it, orders still fulfil and download links still work — they are just
# not emailed. Also gates magic-link sign-in.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="K-Drama Dreams <onboarding@resend.dev>"
MAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Database (optional)
# Without it, an in-memory store is used — fine for testing, wiped on restart.
# Supabase: Project → Settings → Database → Connection string (session pooler)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Object storage (optional archive copy of generated PDFs)
# Downloads do not depend on this — they re-render from the database.
# Supabase example: https://<ref>.supabase.co/storage/v1/object/blueprints
# ---------------------------------------------------------------------------
STORAGE_BUCKET_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_DIR=.data/files

# How long emailed download links stay valid.
DOWNLOAD_TTL_HOURS=72

# Extra server logging.
VERBOSE_LOGS=false
