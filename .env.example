# ---------------------------------------------------------------------------
# K-Drama Dreams — environment
#
# Copy to .env for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (never commit real values).
#
# The app RUNS WITH NONE OF THESE SET. Each block below switches on one
# capability; anything unconfigured degrades gracefully instead of erroring.
# Check what is live at any time: GET /api/config/health
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Public origin, used for Stripe redirects, download links and magic links.
# Leave BLANK on Vercel: links are then built from the domain each request
# actually arrived on, which is what your customers see. Set it only if you
# serve the client from a different host than the API — doing so also enables
# CORS for exactly that origin.
APP_URL=

# Signs download links, sign-in sessions and the /admin dashboard session.
# REQUIRED IN PRODUCTION. Generate one with:  openssl rand -base64 32
APP_SECRET=

# Opens the private dashboard at /admin — a password you type, unlike APP_SECRET
# above, which is a signing key. No default: leave this empty and the dashboard
# refuses every login. Needs APP_SECRET set too, since that signs the session
# cookie. ADMIN_PASSWORD is accepted as an alias for this variable.
APP_SECRET_PW=

# ---------------------------------------------------------------------------
# Payments — pick ONE of the two paths below
# ---------------------------------------------------------------------------

# Path A (recommended): API keys. Enables Stripe Checkout Sessions, which carry
# quiz answers as metadata so fulfilment is fully automatic.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Path B (no-code): paste the Payment Link URL for each tier. Used only when
# STRIPE_SECRET_KEY is absent. Dashboard → Product catalogue → Payment links
STRIPE_PAYMENT_LINK_BLUEPRINT=
STRIPE_PAYMENT_LINK_BUNDLE=
STRIPE_PAYMENT_LINK_COACHING=

# Required for automatic delivery on BOTH paths. Without it, payments succeed
# but nothing is generated or emailed.
# Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Tax class for the products, e.g. txcd_10000000. Only needed if you want
# Stripe's Managed Payments to handle tax for you — it refuses to create a
# checkout unless every product declares one. Left empty, Managed Payments is
# switched off per session, ordinary Checkout runs, and tax is your own
# responsibility. Codes: https://dashboard.stripe.com/settings/tax
STRIPE_TAX_CODE=

# On Path A the app keeps three real Products/Prices in your Stripe dashboard
# (kdd_blueprint, kdd_bundle, kdd_coaching), created on first use. Create them
# up front instead with:  npm run stripe:sync
# Edit them freely in Stripe afterwards — the app never overwrites your changes.

# ---------------------------------------------------------------------------
# The $5 tier's deliverable: your Notion planner share link.
# Kept here rather than in the repo because the repo is public and this link IS
# the product. Notion → Share → Publish → Copy link (allow duplicate as
# template). Without it the tier still sells and still delivers the PDF.
# ---------------------------------------------------------------------------
NOTION_TEMPLATE_URL=

# ---------------------------------------------------------------------------
# AI personalisation (optional)
# Without it, blueprints use the built-in written fallback.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Transactional email (optional)
# Without it, orders still fulfil and download links still work — they are just
# not emailed. Also gates magic-link sign-in.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="K-Drama Dreams <onboarding@resend.dev>"
MAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Database
# Optional for selling — orders are recovered from Stripe, so payments and
# downloads work without it. REQUIRED for the /admin dashboard to mean
# anything: funnel events live in the memory of a single serverless instance
# and are wiped whenever it sleeps, so visitor and click counts read far below
# reality until this is set. Sales and revenue stay accurate either way,
# because those are read from Stripe.
# Supabase: Project → Settings → Database → Connection string (session pooler)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Object storage (optional archive copy of generated PDFs)
# Downloads do not depend on this — they re-render from the database.
# Supabase example: https://<ref>.supabase.co/storage/v1/object/blueprints
# ---------------------------------------------------------------------------
STORAGE_BUCKET_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_DIR=.data/files

# How long emailed download links stay valid.
DOWNLOAD_TTL_HOURS=72

# Extra server logging.
VERBOSE_LOGS=false
